# Briefline CRM — variables de entorno (desarrollo local)
# Copiar a .env:  cp .env.example .env
#
# Los valores son credenciales de DESARROLLO LOCAL (REP-005 / docker-compose).
# NUNCA commitear secrets reales; en producción viven en Render/Neon/GitHub
# (PH-12 OPS-005).

# Database — coincide con docker/compose.yml (postgres 17 local)
# En producción: DATABASE_URL pooled (-pooler) y DIRECT_URL direct de Neon.
DATABASE_URL=postgresql://briefline:briefline-local@localhost:5432/briefline
DIRECT_URL=postgresql://briefline:briefline-local@localhost:5432/briefline

# Auth — secrets de desarrollo; rotar a valores largos aleatorios en producción
JWT_SECRET=local-dev-secret-change-in-production
CSRF_SECRET=local-dev-csrf-secret-change-in-production

# App
NODE_ENV=development
PORT=3000

# CORS — allowlist separada por comas (API-003); la web corre en Vite dev
CORS_ORIGINS=http://localhost:5173
